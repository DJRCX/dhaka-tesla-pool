{
  "name": "dhaka-tesla-pool",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dhaka Tesla Pool — share a seat, split the fare, survive Dhaka traffic",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @teslapool/api --if-present",
    "db:seed": "npm run db:seed -w @teslapool/api --if-present",
    "db:seed:reset": "npm run db:seed:reset -w @teslapool/api --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
