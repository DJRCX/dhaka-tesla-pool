# Optional: override when docker.io/library/postgres:17-alpine cannot be pulled
# POSTGRES_IMAGE=docker.io/pgvector/pgvector:pg16

# Local / Compose defaults — copy to .env and change secrets before use.
POSTGRES_USER=teslapool
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=teslapool

# Host-side URLs (outside Docker). Inside Compose, use host `db` and port 5432.
DATABASE_URL=postgres://teslapool:change-me-locally@localhost:54329/teslapool
TEST_DATABASE_URL=postgres://teslapool:change-me-locally@localhost:54330/teslapool_test

JWT_SECRET=replace-with-32+-random-characters-here
API_PORT=4000
WEB_ORIGIN=http://localhost:43123
# Host-side Next.js rewrite target (npm run dev -w @teslapool/web).
# Inside Compose the web image is built with API_INTERNAL_URL=http://api:4000
# because Next.js bakes rewrites at build time — rebuild the web image if this changes.
API_INTERNAL_URL=http://localhost:48080

FARE_BASE_PAISA=4000
FARE_PER_KM_PAISA=2500
FARE_POOL_DISCOUNT_PERCENT=20
POOL_DETOUR_LIMIT_M=3000
LOG_LEVEL=info
